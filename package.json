{
  "name": "hetzner-cloud-plugin",
  "version": "0.3.0",
  "private": true,
  "description": "Codex skills for direct local access to the Hetzner Cloud and Storage Boxes APIs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:host": "node scripts/check-host.mjs",
    "check": "npm run typecheck && node scripts/generate-api.mjs --check && node scripts/build.mjs --check && npm test"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
